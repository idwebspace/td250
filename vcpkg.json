{
  "name": "td250",
  "version-string": "1.0.0",
  "dependencies": [
    // Ini adalah dependensi dasar yang dibutuhkan Telegram Desktop
    "openssl",
    "zlib",
    "libtgvoip" 
    // Anda mungkin perlu menambahkan dependensi lain dari td250 jika ada
  ],
  "vcpkg-configuration": {
    "default-registry": {
      "kind": "git",
      "repository": "https://github.com/microsoft/vcpkg",
      "baseline": "MASUKKAN_COMMIT_ID_VCPKG_YANG_VALID_DI_SINI" 
    }
  }
}
